# Aucun script d'installation tiers (télémétrie, téléchargements annexes) : seuls les
# fichiers publiés des paquets sont installés. Pour une chaîne de construction souveraine,
# pointez « registry » vers un miroir interne (Verdaccio, Nexus, Artifactory…).
ignore-scripts=true
fund=false
update-notifier=false
