#!/bin/sh
# Contrôle du message de commit (convention du projet, voir CONTRIBUTING.md).
# Activé par : git config core.hooksPath .githooks

msg_file="$1"
line=$(head -n 1 "$msg_file")

# Commits générés par Git lui-même : fusion, annulation, fixup/squash.
case "$line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! ") exit 0 ;;
esac

types='feat|fix|docs|ci|deploy|refactor|test|style|chore|perf|build'
scopes='shared|server|web|deploy|docs|ci|e2e|scripts|k8s|poste|installer'
pattern="^(${types})(\((${scopes})\))?!?: [^A-Z ].{0,70}[^. ]$"

if printf '%s\n' "$line" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<EOF
Message de commit refusé :
  $line

Format attendu : type(scope): description
  - type : feat, fix, docs, ci, deploy, refactor, test, style, chore, perf, build
  - scope (facultatif) : shared, server, web, deploy, docs, ci, e2e, scripts, k8s, poste, installer
  - description en français, première lettre en minuscule, sans point final, 72 caractères au plus
  - changement incompatible : ajouter ! après le type ou le scope (ex. feat(server)!: …)

Exemple : fix(web): corrige le défilement de la liste des risques
EOF
exit 1
